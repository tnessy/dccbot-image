# Copy to deploy.env (gitignored) and fill in the real values, then run ./post-deploy.sh

# Image published by the GitHub workflow (GHCR). Pin a version tag once you have one.
IMAGE=ghcr.io/OWNER/dccbot-image:latest

# Where config.json and the downloads live on the NAS
APPDATA_DIR=/mnt/user/appdata/dccbot
DOWNLOADS_DIR=/mnt/user/downloads
XDCC_SUBDIR=_spike/xdcc

# Publish the API to the LAN address only (it documents no authentication)
API_BIND_IP=192.168.68.58
API_PORT=9999

# File ownership (Unraid default nobody:users)
PUID=99
PGID=100

# IRC identity on irc.rizon.net (leave XDCC_NICK empty to keep a random nick)
XDCC_NICK=
NICKSERV_PASSWORD=

# Passive DCC (leave empty unless a bot is passive-only). Must be a public IP reachable by the bot,
# with the port range forwarded on the router.
XDCC_PASSIVE_LISTEN_IP=
XDCC_PASSIVE_PORT_MIN=15000
XDCC_PASSIVE_PORT_MAX=15010
